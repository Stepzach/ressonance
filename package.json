{
  "name": "ressonance",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply ressonance-db --remote",
    "deploy": "npm run db:migrate && wrangler deploy"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.2.6",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fortawesome/fontawesome-free": "6.7.2",
    "drizzle-kit": "0.31.4",
    "drizzle-orm": "0.44.2",
    "jsdom": "^26.1.0",
    "wrangler": "^4.147.0"
  }
}
